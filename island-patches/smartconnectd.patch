+    // An embedding app names itself here. When it goes away (quit or crash), stop too, so the
+    // network port never stays open without the app that controls it.
+    if let Some(parent) = std::env::var("SMARTCONNECT_PARENT_PID").ok().and_then(|p| p.parse::<i32>().ok()) {
+        tokio::spawn(async move {
+            loop {
+                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+                if unsafe { libc::getppid() } != parent {
+                    tracing::warn!("parent process is gone; shutting down");
+                    std::process::exit(0);
+                }
+            }
+        });
+    }
+
     if args.session_log {
         smartconnect::server::enable_session_logs();
     }
