+/// Largest transfer held in memory.
+const MAX_SEND_BYTES: u64 = 2 * 1024 * 1024 * 1024;
+
+async fn send(name: String, sender_id: String, wait: Duration, paths: Vec<PathBuf>) -> Result<()> {
+    use std::io::Write;
+    let mut files: Vec<(String, Vec<u8>)> = Vec::new();
+    let mut total = 0u64;
+    for path in &paths {
+        let base = path.file_name().and_then(|n| n.to_str()).context("a file without a usable name")?.to_owned();
+        total += std::fs::metadata(path).with_context(|| format!("reading {}", path.display()))?.len();
+        if total > MAX_SEND_BYTES {
+            bail!("the files are larger than {} GiB in total", MAX_SEND_BYTES >> 30);
+        }
+        let data = std::fs::read(path).with_context(|| format!("reading {}", path.display()))?;
+        // Two files of the same name must not collide in the archive.
+        let mut unique = base.clone();
+        let mut n = 1;
+        while files.iter().any(|(existing, _)| *existing == unique) {
+            n += 1;
+            unique = match base.rsplit_once('.') {
+                Some((stem, ext)) if !stem.is_empty() => format!("{stem} {n}.{ext}"),
+                _ => format!("{base} {n}"),
+            };
+        }
+        files.push((unique, data));
+    }
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<Value>();
+    let printer = tokio::spawn(async move {
+        while let Some(event) = rx.recv().await {
+            let mut out = std::io::stdout().lock();
+            let _ = writeln!(out, "{event}");
+            let _ = out.flush();
+        }
+    });
+    let transfer = smartconnect_fex::server::Transfer { files, sender_id, sender_name: name };
+    let result = smartconnect_fex::server::serve(transfer, wait, tx).await;
+    let _ = printer.await;
+    let line = match &result {
+        Ok(()) => json!({"event":"done","ok":true}),
+        Err(e) => json!({"event":"done","ok":false,"message":format!("{e:#}")}),
+    };
+    println!("{line}");
+    result
+}
