+/// Builds a plain zip of stored (uncompressed) entries, sizes and CRC in the headers. No Zip64:
+/// the archive and every entry must stay under 4 GiB.
+pub fn write_stored(entries: &[(&str, &[u8])]) -> Result<Vec<u8>> {
+    if entries.len() > MAX_ENTRIES {
+        bail!("zip: too many files");
+    }
+    let total: usize = entries.iter().map(|(n, d)| d.len() + 2 * n.len() + 76).sum::<usize>() + 22;
+    if total >= u32::MAX as usize {
+        bail!("zip: the transfer is too large (4 GiB limit)");
+    }
+    let mut out = Vec::with_capacity(total);
+    let mut central = Vec::new();
+    for (name, data) in entries {
+        let crc = crc32(data);
+        let offset = out.len() as u32;
+        let size = data.len() as u32;
+        // Flag bit 11: the name is UTF-8.
+        for (sink, sig, extra_version) in [(&mut out, LFH_SIG, false), (&mut central, CDH_SIG, true)] {
+            sink.extend_from_slice(&sig.to_le_bytes());
+            if extra_version {
+                sink.extend_from_slice(&20u16.to_le_bytes()); // version made by
+            }
+            sink.extend_from_slice(&20u16.to_le_bytes()); // version needed
+            sink.extend_from_slice(&0x0800u16.to_le_bytes());
+            sink.extend_from_slice(&METHOD_STORE.to_le_bytes());
+            sink.extend_from_slice(&[0, 0, 0x21, 0]); // time 00:00, date 1980-01-01
+            sink.extend_from_slice(&crc.to_le_bytes());
+            sink.extend_from_slice(&size.to_le_bytes());
+            sink.extend_from_slice(&size.to_le_bytes());
+            sink.extend_from_slice(&(name.len() as u16).to_le_bytes());
+            sink.extend_from_slice(&0u16.to_le_bytes()); // extra length
+        }
+        out.extend_from_slice(name.as_bytes());
+        out.extend_from_slice(data);
+        central.extend_from_slice(&[0; 10]); // comment length, disk, internal and external attributes
+        central.extend_from_slice(&offset.to_le_bytes());
+        central.extend_from_slice(name.as_bytes());
+    }
+    let cd_offset = out.len() as u32;
+    out.extend_from_slice(&central);
+    out.extend_from_slice(&EOCD_SIG.to_le_bytes());
+    out.extend_from_slice(&[0; 4]);
+    out.extend_from_slice(&(entries.len() as u16).to_le_bytes());
+    out.extend_from_slice(&(entries.len() as u16).to_le_bytes());
+    out.extend_from_slice(&(central.len() as u32).to_le_bytes());
+    out.extend_from_slice(&cd_offset.to_le_bytes());
+    out.extend_from_slice(&0u16.to_le_bytes());
+    Ok(out)
+}
