+/// An embedding app can switch each direction off: `SMARTCONNECT_CLIPBOARD_SEND=0` (this computer
+/// to the phone) and `SMARTCONNECT_CLIPBOARD_RECEIVE=0` (phone to this computer).
+fn direction_enabled(var: &str) -> bool {
+    std::env::var(var).map(|v| v != "0").unwrap_or(true)
+}
