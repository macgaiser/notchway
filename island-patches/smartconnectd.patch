@@ -0,0 +1,445 @@
+//! Serves one transfer **to** the phone: the sending side of fex.
+//!
+//! This mirrors what the phone does when it sends (see `docs/protocol/file-exchange.md` §3): zip
+//! the files, start a short-lived HTTPS server with a throwaway certificate, advertise `port`,
+//! `fingerprint` and `token` over the control WebSocket (the caller does that with the values of
+//! the `ready` event), then answer the receiver:
+//!
+//! ```text
+//! phone                                    this server (TLS, self-signed, pinned by the phone)
+//!   GET /websocket (upgrade)          ->
+//!                                     <-   action:Server1001:versionNegotiation?{"version":1}
+//!   ack:Server1001:versionNegotiation ->
+//!                                     <-   action:Server1002:sendRequest?{id, file[], totalSize…}
+//!   ack:Server1002:sendRequest        ->
+//!   GET /download?taskId=<id>         ->   200 application/zip
+//!   action:Client<n>:status?{type:1}  ->
+//!                                     <-   ack:Client<n>:status
+//! ```
+//!
+//! The phone-as-sender flow is observed; that the phone accepts the same flow as a receiver is
+//! inferred from the symmetry of its library, so every request and frame is reported as an event
+//! for the caller to log.
+
+use std::io::Read;
+use std::net::Ipv4Addr;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use anyhow::{Context, Result, bail};
+use futures_util::{SinkExt, StreamExt};
+use serde_json::{Value, json};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::mpsc::{UnboundedSender, unbounded_channel};
+use tokio_rustls::TlsAcceptor;
+use tokio_rustls::rustls::pki_types::{CertificateDer, PrivatePkcs8KeyDer};
+use tokio_rustls::rustls::{self, ServerConfig};
+use tokio_tungstenite::WebSocketStream;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::handshake::derive_accept_key;
+use tokio_tungstenite::tungstenite::protocol::Role;
+
+use crate::frame::{self, FileEntry, Frame, Kind, Name, SendRequest, Status, VersionNegotiation};
+use crate::{tls, zip};
+
+/// Once the phone has connected, how long the whole transfer may take.
+const TRANSFER_TIMEOUT: Duration = Duration::from_secs(600);
+const MAX_HEAD: usize = 16 * 1024;
+
+/// What to send, and how the sender names itself in `sendRequest`.
+pub struct Transfer {
+    /// File name (no directories) and contents.
+    pub files: Vec<(String, Vec<u8>)>,
+    pub sender_id: String,
+    pub sender_name: String,
+}
+
+struct State {
+    task_id: String,
+    archive: Vec<u8>,
+    files: Vec<(String, Vec<u8>)>,
+    request: String,
+    downloaded: AtomicBool,
+    events: UnboundedSender<Value>,
+}
+
+impl State {
+    fn event(&self, v: Value) {
+        let _ = self.events.send(v);
+    }
+}
+
+fn random_bytes<const N: usize>() -> Result<[u8; N]> {
+    let mut b = [0u8; N];
+    std::fs::File::open("/dev/urandom").and_then(|mut f| f.read_exact(&mut b)).context("reading /dev/urandom")?;
+    Ok(b)
+}
+
+/// The phone picks its own ports in `[50000, 59999]`; so do we.
+async fn bind() -> Result<TcpListener> {
+    for _ in 0..40 {
+        let r = u16::from_le_bytes(random_bytes::<2>()?);
+        let port = 50_000 + r % 10_000;
+        if let Ok(l) = TcpListener::bind((Ipv4Addr::UNSPECIFIED, port)).await {
+            return Ok(l);
+        }
+    }
+    TcpListener::bind((Ipv4Addr::UNSPECIFIED, 0)).await.context("binding a port for the transfer")
+}
+
+fn mime_type(name: &str) -> &'static str {
+    let ext = name.rsplit_once('.').map(|(_, e)| e.to_ascii_lowercase()).unwrap_or_default();
+    match ext.as_str() {
+        "png" => "image/png",
+        "jpg" | "jpeg" => "image/jpeg",
+        "gif" => "image/gif",
+        "heic" => "image/heic",
+        "webp" => "image/webp",
+        "mp4" | "m4v" => "video/mp4",
+        "mov" => "video/quicktime",
+        "mp3" => "audio/mpeg",
+        "m4a" => "audio/mp4",
+        "pdf" => "application/pdf",
+        "txt" => "text/plain",
+        "zip" => "application/zip",
+        _ => "application/octet-stream",
+    }
+}
+
+/// Serves `transfer` until the phone reports the outcome. Emits JSON events: first `ready` (the
+/// values to advertise), then one per request and WebSocket frame. `wait` is how long to wait for
+/// the phone's first connection.
+pub async fn serve(transfer: Transfer, wait: Duration, events: UnboundedSender<Value>) -> Result<()> {
+    if transfer.files.is_empty() {
+        bail!("nothing to send");
+    }
+    let key = rcgen::KeyPair::generate().context("generating the transfer key")?;
+    let cert = rcgen::CertificateParams::new(vec!["Lenovo".to_owned()])
+        .context("certificate parameters")?
+        .self_signed(&key)
+        .context("signing the transfer certificate")?;
+    let der: CertificateDer<'static> = cert.der().clone();
+    let fingerprint = tls::fingerprint(der.as_ref());
+    let mut config = ServerConfig::builder_with_provider(Arc::new(rustls::crypto::ring::default_provider()))
+        .with_safe_default_protocol_versions()
+        .context("selecting TLS versions")?
+        .with_no_client_auth()
+        .with_single_cert(vec![der], PrivatePkcs8KeyDer::from(key.serialize_der()).into())
+        .context("TLS server configuration")?;
+    // The control channel is a WebSocket, which needs HTTP/1.1.
+    config.alpn_protocols = vec![b"http/1.1".to_vec()];
+    let acceptor = TlsAcceptor::from(Arc::new(config));
+
+    let listener = bind().await?;
+    let port = listener.local_addr()?.port();
+    let task_id = hex::encode(random_bytes::<8>()?);
+    let token = hex::encode(random_bytes::<16>()?);
+
+    let entries: Vec<(&str, &[u8])> = transfer.files.iter().map(|(n, d)| (n.as_str(), d.as_slice())).collect();
+    let archive = zip::write_stored(&entries)?;
+    let request = SendRequest {
+        id: task_id.clone(),
+        sender_id: transfer.sender_id.clone(),
+        sender_name: transfer.sender_name.clone(),
+        file_name: transfer.files[0].0.clone(),
+        file_count: transfer.files.len() as u64,
+        mime_type: if transfer.files.len() == 1 { mime_type(&transfer.files[0].0).to_owned() } else { "*/*".to_owned() },
+        total_size: archive.len() as u64,
+        files: transfer
+            .files
+            .iter()
+            .enumerate()
+            .map(|(i, (name, data))| FileEntry {
+                name: name.clone(),
+                mime_type: mime_type(name).to_owned(),
+                size: data.len() as u64,
+                dir: false,
+                index: i as i64,
+            })
+            .collect(),
+    };
+    let (done_tx, mut done_rx) = unbounded_channel::<Result<(), String>>();
+    let state = Arc::new(State {
+        task_id: task_id.clone(),
+        archive,
+        files: transfer.files,
+        request: serde_json::to_string(&request)?,
+        downloaded: AtomicBool::new(false),
+        events,
+    });
+    state.event(json!({"event":"ready","port":port,"fingerprint":fingerprint,"token":token,"taskId":task_id,
+        "fileName":request.file_name,"fileCount":request.file_count,"totalSize":request.total_size}));
+
+    let deadline = tokio::time::sleep(wait);
+    tokio::pin!(deadline);
+    let mut contacted = false;
+    loop {
+        tokio::select! {
+            accepted = listener.accept() => {
+                let (tcp, peer) = accepted.context("accepting a connection")?;
+                if !contacted {
+                    contacted = true;
+                    deadline.as_mut().reset(tokio::time::Instant::now() + TRANSFER_TIMEOUT);
+                }
+                state.event(json!({"event":"connection","peer":peer.ip().to_string()}));
+                let (acceptor, state, done) = (acceptor.clone(), state.clone(), done_tx.clone());
+                tokio::spawn(async move {
+                    if let Err(e) = handle(tcp, acceptor, state.clone(), done).await {
+                        state.event(json!({"event":"error","message":format!("{e:#}")}));
+                    }
+                });
+            }
+            outcome = done_rx.recv() => {
+                return match outcome {
+                    Some(Ok(())) => Ok(()),
+                    Some(Err(reason)) => bail!("the phone reported a failure: {reason}"),
+                    None => bail!("the transfer ended without a result"),
+                };
+            }
+            _ = &mut deadline => {
+                if contacted {
+                    bail!("the transfer did not finish in time");
+                }
+                bail!("the phone did not fetch the offer");
+            }
+        }
+    }
+}
+
+async fn read_head<S: AsyncReadExt + Unpin>(s: &mut S) -> Result<String> {
+    let mut head = Vec::new();
+    let mut b = [0u8; 1];
+    while !head.ends_with(b"\r\n\r\n") {
+        if head.len() > MAX_HEAD {
+            bail!("request head too long");
+        }
+        if s.read(&mut b).await? == 0 {
+            bail!("connection closed before a request");
+        }
+        head.push(b[0]);
+    }
+    Ok(String::from_utf8_lossy(&head).into_owned())
+}
+
+fn header<'a>(head: &'a str, name: &str) -> Option<&'a str> {
+    head.lines().skip(1).find_map(|l| {
+        let (k, v) = l.split_once(':')?;
+        k.trim().eq_ignore_ascii_case(name).then(|| v.trim())
+    })
+}
+
+fn percent_decode(v: &str) -> String {
+    let b = v.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == b'%' && i + 2 < b.len() && v.is_char_boundary(i + 1) && v.is_char_boundary(i + 3) {
+            if let Ok(x) = u8::from_str_radix(&v[i + 1..i + 3], 16) {
+                out.push(x);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(if b[i] == b'+' { b' ' } else { b[i] });
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+fn query_value(target: &str, key: &str) -> Option<String> {
+    let (_, query) = target.split_once('?')?;
+    query.split('&').find_map(|pair| {
+        let (k, v) = pair.split_once('=').unwrap_or((pair, ""));
+        (k == key).then(|| percent_decode(v))
+    })
+}
+
+/// `bytes=<from>-[<to>]` within a body of `len` bytes.
+fn parse_range(value: &str, len: usize) -> Option<(usize, usize)> {
+    let spec = value.trim().strip_prefix("bytes=")?;
+    let (from, to) = spec.split_once('-')?;
+    let from: usize = from.trim().parse().ok()?;
+    let to: usize = if to.trim().is_empty() { len.checked_sub(1)? } else { to.trim().parse().ok()? };
+    (from <= to && to < len).then_some((from, to))
+}
+
+async fn respond<S: AsyncWriteExt + Unpin>(s: &mut S, head: &str, ctype: &str, body: &[u8]) -> Result<bool> {
+    let range = header(head, "range").and_then(|r| parse_range(r, body.len()));
+    let (status, part, extra) = match range {
+        Some((from, to)) => ("206 Partial Content", &body[from..=to], format!("Content-Range: bytes {from}-{to}/{}\r\n", body.len())),
+        None => ("200 OK", body, String::new()),
+    };
+    let resp = format!(
+        "HTTP/1.1 {status}\r\nContent-Type: {ctype}\r\nAccept-Ranges: bytes\r\n{extra}Content-Length: {}\r\nConnection: close\r\n\r\n",
+        part.len()
+    );
+    s.write_all(resp.as_bytes()).await?;
+    s.write_all(part).await?;
+    s.flush().await?;
+    let _ = s.shutdown().await;
+    // Whether the response reached the end of the body.
+    Ok(range.is_none_or(|(_, to)| to + 1 == body.len()))
+}
+
+async fn handle(
+    tcp: TcpStream,
+    acceptor: TlsAcceptor,
+    state: Arc<State>,
+    done: UnboundedSender<Result<(), String>>,
+) -> Result<()> {
+    let _ = tcp.set_nodelay(true);
+    let mut s = acceptor.accept(tcp).await.context("TLS handshake with the phone")?;
+    let head = read_head(&mut s).await?;
+    let target = head.split_whitespace().nth(1).unwrap_or("").to_owned();
+    let path = target.split('?').next().unwrap_or("").to_owned();
+    state.event(json!({"event":"request","path":path,"range":header(&head, "range")}));
+
+    match path.as_str() {
+        "/websocket" => {
+            let key = header(&head, "sec-websocket-key").context("WebSocket upgrade without a key")?;
+            let resp = format!(
+                "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {}\r\n\r\n",
+                derive_accept_key(key.as_bytes())
+            );
+            s.write_all(resp.as_bytes()).await?;
+            let ws = WebSocketStream::from_raw_socket(s, Role::Server, None).await;
+            control(ws, state, done).await
+        }
+        "/download" => {
+            if query_value(&target, "taskId").as_deref() != Some(state.task_id.as_str()) {
+                let body = b"download -> taskId does not exist!";
+                respond(&mut s, &head, "text/plain; charset=utf-8", body).await?;
+                return Ok(());
+            }
+            if respond(&mut s, &head, "application/zip", &state.archive).await? {
+                state.downloaded.store(true, Ordering::SeqCst);
+                state.event(json!({"event":"downloaded","bytes":state.archive.len()}));
+            }
+            Ok(())
+        }
+        "/downloadFile" => {
+            let index = query_value(&target, "index").and_then(|i| i.parse::<usize>().ok());
+            match index.and_then(|i| state.files.get(i).map(|f| (i, f))) {
+                Some((i, (name, data))) if query_value(&target, "taskId").as_deref() == Some(state.task_id.as_str()) => {
+                    if respond(&mut s, &head, mime_type(name), data).await? {
+                        state.event(json!({"event":"downloadedFile","index":i,"bytes":data.len()}));
+                        if i + 1 == state.files.len() {
+                            state.downloaded.store(true, Ordering::SeqCst);
+                        }
+                    }
+                }
+                _ => {
+                    respond(&mut s, &head, "text/plain; charset=utf-8", b"downloadFile -> does not exist!").await?;
+                }
+            }
+            Ok(())
+        }
+        _ => {
+            s.write_all(b"HTTP/1.1 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 19\r\nConnection: close\r\n\r\n404 page not found\n").await?;
+            let _ = s.shutdown().await;
+            Ok(())
+        }
+    }
+}
+
+async fn control<S>(mut ws: WebSocketStream<S>, state: Arc<State>, done: UnboundedSender<Result<(), String>>) -> Result<()>
+where
+    S: AsyncReadExt + AsyncWriteExt + Unpin,
+{
+    let negotiation = serde_json::to_string(&VersionNegotiation { version: frame::VERSION })?;
+    ws.send(Message::text(Frame::action("Server1001", Name::VersionNegotiation, Some(negotiation)).to_string())).await?;
+    let mut offered = false;
+    let mut reported = false;
+    while let Some(message) = ws.next().await {
+        let text = match message {
+            Ok(Message::Text(t)) => t,
+            Ok(Message::Close(_)) | Err(_) => break,
+            Ok(_) => continue,
+        };
+        state.event(json!({"event":"frame","text":text.as_str()}));
+        let Ok(f) = Frame::parse(&text) else { continue };
+        match (f.kind, f.name) {
+            (Kind::Ack, Name::VersionNegotiation) if !offered => {
+                offered = true;
+                ws.send(Message::text(Frame::action("Server1002", Name::SendRequest, Some(state.request.clone())).to_string())).await?;
+            }
+            (Kind::Action, Name::Status) => {
+                ws.send(Message::text(Frame::ack(&f.id, Name::Status, None).to_string())).await?;
+                if let Ok(status) = f.json::<Status>() {
+                    match status.kind {
+                        frame::STATUS_STARTED => {}
+                        frame::STATUS_COMPLETE => {
+                            reported = true;
+                            let _ = done.send(Ok(()));
+                        }
+                        other => {
+                            reported = true;
+                            let reason = if status.reason.is_empty() { format!("status {other}") } else { status.reason };
+                            let _ = done.send(Err(reason));
+                        }
+                    }
+                }
+            }
+            (Kind::Action, name) => {
+                ws.send(Message::text(Frame::ack(&f.id, name, Some("{}".into())).to_string())).await?;
+            }
+            _ => {}
+        }
+    }
+    if !reported {
+        // No status came: the download itself tells whether the files arrived.
+        let _ = done.send(if state.downloaded.load(Ordering::SeqCst) {
+            Ok(())
+        } else {
+            Err("the phone closed the transfer without fetching the files".into())
+        });
+    }
+    Ok(())
+}
