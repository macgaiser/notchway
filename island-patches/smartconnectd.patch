+            token: ready["token"].as_str().unwrap().to_owned(),
+        };
+        let pulled = client::pull(&offer, client::DEFAULT_MAX_BYTES).await.unwrap();
+        assert_eq!(pulled.request.file_count, 2);
+        let entries = zip::read_all(&pulled.archive).unwrap();
+        assert_eq!(entries.iter().map(|e| (e.name.clone(), e.data.clone())).collect::<Vec<_>>(), files);
+        server.await.unwrap().unwrap();
+    }
+
+    #[tokio::test]
+    async fn gives_up_when_nobody_fetches() {
+        let (tx, _rx) = unbounded_channel();
+        let transfer = Transfer { files: vec![("a.txt".into(), b"x".to_vec())], sender_id: String::new(), sender_name: String::new() };
+        let err = serve(transfer, Duration::from_millis(200), tx).await.unwrap_err();
+        assert!(format!("{err:#}").contains("did not fetch"), "{err:#}");
+    }
+
+    #[test]
+    fn parses_ranges_and_queries() {
+        assert_eq!(parse_range("bytes=0-", 10), Some((0, 9)));
+        assert_eq!(parse_range("bytes=2-5", 10), Some((2, 5)));
+        assert_eq!(parse_range("bytes=5-20", 10), None);
+        assert_eq!(query_value("/download?taskId=ab%2Bc&token=t", "taskId").as_deref(), Some("ab+c"));
+        assert_eq!(query_value("/download", "taskId"), None);
+    }
+}
