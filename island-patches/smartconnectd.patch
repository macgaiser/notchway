+/// Embedding apps (Causeway Notch) run sandboxed, where the default locations are too long for a
+/// Unix socket path (104 bytes). They name a short directory here for both sockets.
+fn socket_dir_override() -> Option<PathBuf> {
+    let dir = std::env::var_os("SMARTCONNECT_SOCKET_DIR").filter(|d| !d.is_empty()).map(PathBuf::from)?;
+    let _ = std::fs::create_dir_all(&dir);
+    Some(dir)
+}
+
 #[cfg(target_os = "macos")]
 pub fn runtime_dir() -> PathBuf {
+    if let Some(dir) = socket_dir_override() {
+        return dir;
+    }
     // `$TMPDIR` is already private to the user on macOS. Keep our own subdirectory so a stale
     // socket from a crashed daemon is easy to identify and remove.
     let base = std::env::var_os("TMPDIR").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
